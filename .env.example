# QoreChain Diana testnet only. Endpoint overrides remain disabled.
QORE_NETWORK=testnet

# Server-only registration configuration. Supply a treasury you control on Diana.
# Never substitute a random address. Missing configuration disables payment intents.
# REGISTRATION_TREASURY=qor1...
# Local zero-cost setup: npm run db:setup creates ignored .local/runtime.json.
# For an authorized HTTPS deployment, configure these on the SERVER only:
# APP_ORIGIN=https://your-confirmed-app-origin.example
# AUTH_DATABASE_URL=postgresql://reeklaim_auth:<separate-password>@<db-host>:5432/<db>?sslmode=verify-full
# DATABASE_URL=postgresql://reeklaim_runtime:<separate-password>@<db-host>:5432/<db>?sslmode=verify-full
# REEKLAIM_DATABASE_CA_PEM=<complete PEM contents of the Supabase Database Settings certificate>
# AUTH_CSRF_SECRET=<independent-32-byte-random-key-as-64-hex-characters>
# PRIVATE_STORAGE_KEY=<independent-32-byte-random-key-as-64-hex-characters>
# PRIVATE_STORAGE_DIRECTORY=/absolute/private/persistent/encrypted-evidence
# Optional durable private bucket. Set all three together. Server only.
# PRIVATE_OBJECT_ORIGIN=https://yourproject.supabase.co
# PRIVATE_OBJECT_BUCKET=private-evidence
# PRIVATE_OBJECT_KEY=<server-only Supabase storage credential>
# NODE_ENV=production
# PORT=3000
# BIND_HOST=127.0.0.1
# Migration shell only, never runtime/frontend:
# MIGRATION_DATABASE_URL=postgresql://<migration-owner>:<password>@<db-host>/<db>?sslmode=verify-full
# MIGRATION_EXPECTED_HOST=<approved-host>
# MIGRATION_EXPECTED_DATABASE=<approved-database>
# MIGRATION_EXPECTED_ROLE=<approved-migration-role>
# No Supabase Auth login or browser service-role key is used.
# A production deployment needs persistent private storage; ephemeral function disk is unsupported.

# Enable only after the operator verifies the configured treasury and Diana setup.
# DIANA_PAYMENT_COLLECTION_APPROVED=yes
# Enable only after a genuine human-approved two-message QoreX trial succeeds.
# DIANA_ATOMIC_REWARDS_VERIFIED=yes
