{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/build-vercel-runtime.mjs",
  "outputDirectory": "dist",
  "env": {
    "NODEJS_HELPERS": "0"
  },
  "functions": {
    "api/dispatch.mjs": {
      "includeFiles": ".vercel-runtime/api.mjs",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/((?!api(?:/|$)).*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'sha256-2uPvXltlCnjUhcyb4o89WihERbGpHrgcKWdggS3nt0g='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/dispatch?__rk_route=$1"
    },
    {
      "src": "/api$",
      "status": 404
    },
    {
      "src": "/([^.]*)",
      "dest": "/index.html"
    }
  ]
}
